[TEMPLATE]
# =============================================================================
# FreelanceXchain API — Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values.
# Variables marked [REQUIRED] will crash the server if missing.
# Variables marked [PROD-ONLY] crash only when NODE_ENV=production.
# All others are optional with defaults shown.
# =============================================================================

# ─── Server ──────────────────────────────────────────────────────────────────
# PORT=3000                                          # HTTP listen port (default: 3000)
# NODE_ENV=development                                # development | test | production
# BASE_URL=http://localhost:3000                      # Override auto-detected base URL
# PUBLIC_URL=http://localhost:5173                    # Public-facing URL for email links
# FRONTEND_URL=http://localhost:5173                  # Frontend app URL for redirects
# ENABLE_API_DOCS=false                               # Enable Swagger UI at /api-docs
# LOG_LEVEL=info                                      # debug | info | warn | error
# DISABLE_RATE_LIMITER=false                          # Set to true to disable rate limiting (useful in dev)
# APP_BUILD_SHA=dev                                   # Commit SHA baked into the image; GET / appends +build.<sha> to version

# ─── Appwrite [REQUIRED] ────────────────────────────────────────────────────
APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=your-project-id
APPWRITE_API_KEY=your-api-key

# Appwrite Storage Buckets (defaults shown)
# APPWRITE_PROPOSAL_ATTACHMENTS_BUCKET=proposal-attachments
# APPWRITE_PROJECT_ATTACHMENTS_BUCKET=project-attachments
# APPWRITE_DISPUTE_EVIDENCE_BUCKET=dispute-evidence
# APPWRITE_PORTFOLIO_IMAGES_BUCKET=portfolio-images
# APPWRITE_MILESTONE_DELIVERABLES_BUCKET=milestone-deliverables

# ─── Auth ─────────────────────────────────────────────────────────────────────
# Auth is Appwrite-managed (session JWTs issued/validated by Appwrite). No
# JWT_SECRET/JWT_REFRESH_SECRET are needed — see CONFIGURATION.md.

# ─── CSRF [PROD-ONLY] ───────────────────────────────────────────────────────
# CSRF_SECRET=your-csrf-secret-min-32-chars          # Required in production

# ─── MFA Encryption [PROD-ONLY] ─────────────────────────────────────────────
# MFA_ENCRYPTION_KEY=your-mfa-encryption-key-32-chars # Required in production

# ─── CORS ────────────────────────────────────────────────────────────────────
# CORS_ORIGIN=http://localhost:3000,https://your-frontend.com

# ─── LLM / AI Skill Matching [REQUIRED] ────────────────────────────────────
LLM_API_URL=https://api.anthropic.com
LLM_MODEL=claude-haiku-4.5
# LLM_API_KEY=your-api-key                           # Optional auth

# ─── Blockchain ──────────────────────────────────────────────────────────────
# BLOCKCHAIN_MODE=simulated                           # simulated | real (default: simulated)
# BLOCKCHAIN_RPC_URL=http://127.0.0.1:7545           # Ganache / Infura / Polygon RPC
# BLOCKCHAIN_PRIVATE_KEY=your-private-key-hex         # Required when MODE=real
# BLOCKCHAIN_WEBHOOK_SECRET=your-webhook-secret       # HMAC for blockchain webhook verification
# PLATFORM_ARBITER_ADDRESS=0x...                       # Address that resolves on-chain disputes (required when MODE=real)
# PLATFORM_ARBITER_PRIVATE_KEY=your-arbiter-key-hex    # Private key for PLATFORM_ARBITER_ADDRESS (required for real-mode dispute resolution)

# ─── Smart Contract Addresses (per-network, all optional) ───────────────────
# HARDHAT_REPUTATION_ADDRESS=
# HARDHAT_ESCROW_ADDRESS=
# HARDHAT_AGREEMENT_ADDRESS=
# HARDHAT_DISPUTE_ADDRESS=
# HARDHAT_MILESTONE_ADDRESS=

# AMOY_REPUTATION_ADDRESS=
# AMOY_ESCROW_ADDRESS=
# AMOY_AGREEMENT_ADDRESS=
# AMOY_DISPUTE_ADDRESS=
# AMOY_MILESTONE_ADDRESS=

# POLYGON_REPUTATION_ADDRESS=
# POLYGON_ESCROW_ADDRESS=
# POLYGON_AGREEMENT_ADDRESS=
# POLYGON_DISPUTE_ADDRESS=
# POLYGON_MILESTONE_ADDRESS=

# MAINNET_REPUTATION_ADDRESS=
# MAINNET_ESCROW_ADDRESS=
# MAINNET_AGREEMENT_ADDRESS=
# MAINNET_DISPUTE_ADDRESS=
# MAINNET_MILESTONE_ADDRESS=

# ─── Didit KYC ──────────────────────────────────────────────────────────────
# DIDIT_API_KEY=your-didit-api-key
# DIDIT_API_URL=https://verification.didit.me
# DIDIT_WEBHOOK_SECRET=your-didit-webhook-secret
# DIDIT_WORKFLOW_ID=your-workflow-id
# ALLOW_INSECURE_DIDIT_WEBHOOKS=false                 # Local-only bypass, keep false in prod

# ─── Email (Cloudflare) ─────────────────────────────────────────────────────
# CLOUDFLARE_API_TOKEN=your-cloudflare-api-token
# CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
# EMAIL_FROM=noreply@freelancexchain.com
# EMAIL_WEBHOOK_SECRET=your-email-webhook-hmac-secret  # Shared secret with email worker

# ─── Redis ───────────────────────────────────────────────────────────────────
# REDIS_HOST=localhost                                  # Redis hostname
# REDIS_PORT=6379                                       # Redis port
# REDIS_PASSWORD=your-redis-password                   # Required for Redis Cloud
# REDIS_TLS=false                                       # Set true for TLS (Redis Cloud Essentials uses false on port 19149)

# ─── Crypto News (cryptocurrency.cv proxy) ─────────────────────────────────
# CRYPTO_NEWS_BASE_URL=https://cryptocurrency.cv     # Upstream free crypto news API
# CRYPTO_NEWS_API_KEY=your-api-key                   # Optional: sent as X-API-Key for premium endpoints
# CRYPTO_NEWS_TIMEOUT_MS=10000                       # Upstream request timeout
# CRYPTO_NEWS_CACHE_TTL_MS=60000                     # In-memory response cache TTL (0 disables)

# ─── Stripe Billing (Pro plan) ───────────────────────────────────────────────
# Unset = billing disabled: the app still boots, /api/billing/* returns 503, and
# every user is Free (fail closed — never the reverse).
# Billing counts as configured only when the API key, the webhook secret and the
# monthly price id are ALL set; a partial config is treated as unconfigured.
# Checkout/portal redirects are built from FRONTEND_URL.
# STRIPE_BASE_URL=https://api.stripe.com              # Stripe API host (override only for a proxy/mock)
# STRIPE_API_KEY=sk_test_...                          # Server-side key. Prefer a restricted key (rk_test_...)
# STRIPE_SECRET_KEY=                                  # Optional alias for STRIPE_API_KEY; API_KEY wins
# STRIPE_PUBLISHABLE_KEY=pk_test_...                  # Client-side key (safe to expose)
# STRIPE_WEBHOOK_SECRET=whsec_...                     # Signing secret for POST /api/webhooks/stripe
# STRIPE_MONTHLY_PRICE_ID=price_...                   # Monthly recurring Price on the Pro Product
# STRIPE_ANNUAL_PRICE_ID=price_...                    # Annual Price on the SAME Pro Product (optional)
# BILLING_DEV_GRANT_PRO=false                         # Dev-only: treat everyone as Pro when Stripe is unconfigured (fatal in production)
