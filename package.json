{
  "name": "blockchain-freelance-marketplace",
  "version": "1.0.47",
  "description": "A decentralized freelance marketplace with AI skill matching and blockchain payments",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "openapi:generate": "tsx scripts/generate-openapi.ts",
    "openapi:check": "tsx scripts/check-openapi.ts",
    "docs:check": "tsx scripts/check-markdown-links.ts",
    "docs:lint": "markdownlint-cli2 \"**/*.md\"",
    "start": "node dist/index.js",
    "start:prod": "tsx src/index.ts",
    "dev": "cross-env NODE_ENV=development BLOCKCHAIN_MODE=real BLOCKCHAIN_RPC_URL=http://127.0.0.1:7545 tsx watch src/index.ts",
    "prod": "cross-env NODE_ENV=production BLOCKCHAIN_MODE=real BLOCKCHAIN_RPC_URL=https://rpc-amoy.polygon.technology tsx src/index.ts",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
    "test:coverage": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage",
    "test:ci": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage --passWithNoTests",
    "test:plat": "node PLAT/run-plat-test-cases.cjs",
    "lint": "eslint src/**/*.ts",
    "security:audit": "pnpm audit --audit-level=moderate",
    "security:alerts": "bash scripts/check-dependabot-alerts.sh",
    "security:audit:fix": "pnpm audit --fix",
    "security:check": "pnpm audit --audit-level=high --prod",
    "compile": "hardhat compile --config hardhat.config.cjs",
    "deploy:reputation": "hardhat run scripts/deploy.cjs --network amoy --config hardhat.config.cjs",
    "deploy:escrow": "hardhat run scripts/deploy-escrow.cjs --network amoy --config hardhat.config.cjs",
    "deploy:local": "node scripts/deploy-to-hardhat.cjs",
    "deploy:contracts": "tsx scripts/deploy-contracts.ts",
    "deploy:contracts:dev": "cross-env BLOCKCHAIN_RPC_URL=http://127.0.0.1:7545 tsx scripts/deploy-contracts.ts",
    "deploy:contracts:prod": "cross-env BLOCKCHAIN_RPC_URL=https://rpc-amoy.polygon.technology tsx scripts/deploy-contracts.ts",
    "setup:polygon": "tsx scripts/setup-polygon-testnet.ts",
    "check:balance": "tsx scripts/check-balance.ts",
    "setup:appwrite-db": "tsx scripts/setup-appwrite-db.ts",
    "reconcile:subscriptions": "tsx scripts/reconcile-subscriptions.ts"
  },
  "keywords": [
    "freelance",
    "marketplace",
    "blockchain",
    "ai",
    "skill-matching"
  ],
  "author": "KenshinPH",
  "license": "ISC",
  "dependencies": {
    "@opencoredev/email-sdk": "^0.6.5",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "csrf-csrf": "^4.0.3",
    "dotenv": "^17.4.2",
    "ethers": "^6.17.0",
    "express": "^4.22.2",
    "file-type": "22.0.1",
    "form-data": "^4.0.6",
    "helmet": "^8.3.0",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.3.0",
    "node-appwrite": "^27.0.0",
    "node-cron": "^4.6.0",
    "stripe": "22.6.0",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^14.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@jest/globals": "29.7.0",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.1.1",
    "@types/node-cron": "^3.0.11",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "^4.1.8",
    "@typescript-eslint/eslint-plugin": "^8.64.0",
    "@typescript-eslint/parser": "^8.64.0",
    "babel-plugin-istanbul": "^8.0.0",
    "cross-env": "^10.1.0",
    "eslint": "^10.7.0",
    "fast-check": "^4.9.0",
    "globals": "^17.7.0",
    "hardhat": "^3.10.0",
    "jest": "^29.7.0",
    "markdownlint-cli2": "^0.23.2",
    "minimatch": "^10.2.5",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.11",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3"
  },
  "packageManager": "pnpm@10.28.1",
  "engines": {
    "node": ">=20",
    "pnpm": ">=8"
  },
  "pnpm": {
    "strictPeerDependencies": false,
    "shamefullyHoist": true,
    "autoInstallPeers": true,
    "publicHoistPattern": [
      "@types/*"
    ],
    "overrides": {
      "cookie@<0.7.0": ">=0.7.0",
      "tmp@<=0.2.3": ">=0.2.4",
      "lodash@>=4.0.0 <=4.17.22": ">=4.17.23",
      "undici@>=6.0.0 <7.0.0": "6.28.0",
      "undici@>=7.0.0 <8.0.0": "7.29.0",
      "undici@>=8.0.0 <9.0.0": "8.9.0",
      "bn.js@>=5.0.0 <5.2.3": ">=5.2.3",
      "bn.js@<4.12.3": ">=4.12.3",
      "minimatch@<3.1.3": ">=3.1.3",
      "minimatch@>=5.0.0 <5.1.7": ">=5.1.7",
      "minimatch@>=9.0.0 <9.0.6": ">=9.0.6",
      "minimatch@>=5.0.0 <5.1.8": ">=5.1.8",
      "minimatch@>=9.0.0 <9.0.7": ">=9.0.7",
      "minimatch@>=10.0.0 <10.2.3": ">=10.2.3",
      "minimatch@<3.1.4": ">=3.1.4",
      "test-exclude": "^7.0.1",
      "multer@<2.3.0": ">=2.3.0",
      "serialize-javascript@<=7.0.2": ">=7.0.3",
      "ajv@<6.14.0": ">=6.14.0",
      "immutable@>=4.0.0-rc.1 <4.3.8": ">=4.3.8",
      "adm-zip@<=0.6.0": ">=0.6.1",
      "sharp@<0.35.4": ">=0.35.4",
      "js-yaml@>=3.0.0 <3.15.2": ">=3.15.2",
      "js-yaml@>=4.0.0 <4.3.1": "4.3.1",
      "brace-expansion@>=4.0.0 <5.0.9": "5.0.9",
      "body-parser@<1.20.6": "1.20.6",
      "browserslist@<=4.28.6": ">=4.28.7",
      "qs@<6.16.0": ">=6.16.0",
      "smol-toml@<=1.7.0": ">=1.7.1"
    }
  }
}
